{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "lib": ["ESNext", "esnext.disposable"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "overrides": [
          {
            "include": ["fork/brandCopy.test.ts"],
            "options": { "diagnosticSeverity": { "nodeBuiltinImport": "off" } }
          }
        ]
      }
    ]
  },
  "include": ["**/*.ts"]
}
